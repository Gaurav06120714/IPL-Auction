{
  "name": "ipl-auction-backend",
  "version": "1.0.0",
  "description": "IPL Fantasy Auction - Express + Socket.io Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch ./src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:seed": "tsx ./src/db/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^5.1.0",
    "nanoid": "^5.1.7",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
